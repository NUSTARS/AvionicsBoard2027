# Build only the autocodeModel export and its shared dependencies for CM7.
# Keeping this override outside generated Debug/*.mk preserves it on IDE regen.
MODEL_ROOT := ../../../../ActiveAero2027/STM32AutocodeLib/CM7
MODEL_EXPORT_SRC := ../../../../ActiveAero2027/activeControlSim/build_autocodeModel/toIDE/Src
MODEL_NAMES := $(notdir $(wildcard $(MODEL_EXPORT_SRC)/*.c))
MODEL_OBJS := $(patsubst %.c,modelonly_%.o,$(MODEL_NAMES))
MODEL_HEADERS := $(wildcard $(MODEL_ROOT)/Inc/*.h)
LIBS := -L. -lautocodeModel_CM7

modelonly_%.o: $(MODEL_ROOT)/Src/%.c $(MODEL_HEADERS) ../makefile.targets
	arm-none-eabi-gcc "$<" -mcpu=cortex-m7 -std=gnu11 -g3 -c -I"$(MODEL_ROOT)/Inc" -O2 -ffunction-sections -fdata-sections -Wall -MMD -MP -MF"$(@:%.o=%.d)" -MT"$@" --specs=nano.specs -mfpu=fpv5-d16 -mfloat-abi=hard -mthumb -o "$@"

libautocodeModel_CM7.a: $(MODEL_OBJS) ../makefile.targets
	arm-none-eabi-ar rcs "$@" $(MODEL_OBJS)

AvionicsBoardV1_CM7.elf AvionicsBoardV1_CM7.map: libautocodeModel_CM7.a
-include $(MODEL_OBJS:.o=.d)

# Recompile consumers whenever the generated model archive changes, including
# copies whose preserved source timestamps predate existing firmware objects.
Core/Src/main.o Core/Src/autocode_runner.o: libautocodeModel_CM7.a

# A fresh IDE regeneration discovers this Core/Src file automatically. Include
# it also when compiling with an existing generated source/object list.
ifeq ($(filter %/IMURunningBuffer.o,$(OBJS)),)
USER_OBJS += Core/Src/IMURunningBuffer.o
endif
AvionicsBoardV1_CM7.elf AvionicsBoardV1_CM7.map: Core/Src/IMURunningBuffer.o
-include Core/Src/IMURunningBuffer.d

# Allow CLI builds using source lists generated before the ADC was enabled.
ADC_DRIVER_DIR := Drivers/STM32H7xx_HAL_Driver
ADC_DRIVER_OBJS := $(addprefix $(ADC_DRIVER_DIR)/,stm32h7xx_hal_adc.o stm32h7xx_hal_adc_ex.o)
ADC_FALLBACK_OBJS := $(filter-out $(patsubst ./%,%,$(OBJS)),$(ADC_DRIVER_OBJS))
ifneq ($(ADC_FALLBACK_OBJS),)
$(ADC_FALLBACK_OBJS): $(ADC_DRIVER_DIR)/%.o: ../../$(ADC_DRIVER_DIR)/Src/%.c
	arm-none-eabi-gcc "$<" -mcpu=cortex-m7 -mthumb -mfpu=fpv5-d16 -mfloat-abi=hard -std=gnu11 -g3 -DCORE_CM7 -DUSE_HAL_DRIVER -DSTM32H745xx -I../Core/Inc -I../../$(ADC_DRIVER_DIR)/Inc -I../../Drivers/CMSIS/Device/ST/STM32H7xx/Include -I../../Drivers/CMSIS/Include -ffunction-sections -fdata-sections -MMD -MP -c -o "$@"
USER_OBJS += $(ADC_FALLBACK_OBJS)
endif
ifeq ($(filter %/AD8495.o,$(OBJS)),)
USER_OBJS += Core/Src/AD8495.o
endif
AvionicsBoardV1_CM7.elf AvionicsBoardV1_CM7.map: Core/Src/AD8495.o $(ADC_DRIVER_OBJS)
-include Core/Src/AD8495.d $(ADC_FALLBACK_OBJS:.o=.d)
